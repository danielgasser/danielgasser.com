# Cloudflare Pages routing — reproduces the old Express server.js
# Express did: /->index.html, /de->index-de.html, /fr->index-fr.html, *->index.html
#
# Pretty language routes (explicit 200 = serve, no redirect).
# (Cloudflare Pages also serves /de/index.html for /de automatically; these make it explicit.)
/de      /de/index.html      200
/fr      /fr/index.html      200
#
# Legacy .htm entry points: permanent redirect to the canonical URLs.
# (Cloudflare Pages already 308s the .html variants on its own.)
/index.htm       /       301
/de/index.htm    /de/    301
/fr/index.htm    /fr/    301
#
# Wildcard fallback to the English page (replicates Express app.get('*')).
# Real static assets always take precedence over _redirects, so this only
# catches otherwise-unmatched paths.
/*       /index.html         200
